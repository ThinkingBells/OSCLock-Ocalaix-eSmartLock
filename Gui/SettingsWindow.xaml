<Window x:Class="OSCLock.Gui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Height="530" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#14151C"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="UsernameLabelText" Grid.Row="0" Foreground="#B7BBC9" FontSize="13" Margin="0,0,0,6" />
        <TextBox x:Name="UsernameBox" Grid.Row="1" Height="32" Padding="8,4" VerticalContentAlignment="Center"
                 Background="#1E2029" Foreground="White" BorderBrush="#33364A" BorderThickness="1" CaretBrush="White" />

        <TextBlock x:Name="PasswordLabelText" Grid.Row="3" Foreground="#B7BBC9" FontSize="13" Margin="0,0,0,6" />
        <PasswordBox x:Name="PasswordInput" Grid.Row="4" Height="32" Padding="8,4" VerticalContentAlignment="Center"
                     Background="#1E2029" Foreground="White" BorderBrush="#33364A" BorderThickness="1" CaretBrush="White" />

        <CheckBox x:Name="StartWithWindowsBox" Grid.Row="6"
                  Foreground="#B7BBC9" FontSize="13" Margin="0,0,0,8" />
        <CheckBox x:Name="StartMinimizedBox" Grid.Row="7"
                  Foreground="#B7BBC9" FontSize="13" />

        <TextBlock x:Name="HotkeyLabelText" Grid.Row="9" Foreground="#B7BBC9" FontSize="13" Margin="0,0,0,6" />
        <TextBox x:Name="HotkeyBox" Grid.Row="10" Height="32" Padding="8,4" VerticalContentAlignment="Center"
                 IsReadOnly="True" Cursor="Hand"
                 Background="#1E2029" Foreground="White" BorderBrush="#33364A" BorderThickness="1"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />

        <TextBlock x:Name="LanguageLabelText" Grid.Row="12" Foreground="#B7BBC9" FontSize="13" Margin="0,0,0,6" />
        <ComboBox x:Name="LanguageBox" Grid.Row="13" Height="32" VerticalContentAlignment="Center"
                  Background="#1E2029" Foreground="Black" BorderBrush="#33364A" BorderThickness="1"
                  SelectionChanged="LanguageBox_SelectionChanged">
            <ComboBoxItem Content="Català" Tag="Catalan" />
            <ComboBoxItem Content="English" Tag="English" />
        </ComboBox>

        <TextBlock x:Name="StatusMessage" Grid.Row="14" Text="" FontSize="12"
                   VerticalAlignment="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButtonText" Width="90" Height="34" Margin="0,0,10,0"
                    Click="CancelButton_Click" Cursor="Hand"
                    Background="#2A2D3A" Foreground="#C7CBDA" BorderThickness="0" />
            <Button x:Name="SaveButtonText" Width="90" Height="34" Cursor="Hand"
                    Click="SaveButton_Click" Background="#4C6FFF" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
