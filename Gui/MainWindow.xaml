<Window x:Class="OSCLock.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSCLock" Height="480" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#14151C"
        Icon="../References/Heart.ico"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Button x:Name="SettingsButton" Grid.Row="0" Content="&#9881;"
                Width="36" Height="36" FontSize="18"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,14,14,0"
                Foreground="#8A8FA3" Background="Transparent" BorderThickness="0"
                Cursor="Hand" Click="SettingsButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#22252F" />
                            <Setter Property="Foreground" Value="#C7CBDA" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Viewbox Grid.Row="0" Width="150" Height="150" Margin="0,30,0,0">
            <Canvas Width="140" Height="140">
                <Path x:Name="Shackle"
                      Data="M 35,70 L 35,45 A 35,35 0 0 1 105,45 L 105,70"
                      Stroke="#5B6072" StrokeThickness="14"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" RenderTransformOrigin="0.25,1">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ShackleRotate" Angle="0" />
                    </Path.RenderTransform>
                </Path>
                <Rectangle x:Name="Body" Canvas.Top="62" Canvas.Left="18"
                           Width="104" Height="70" RadiusX="16" RadiusY="16"
                           Fill="#3A3F52" />
                <Ellipse Canvas.Top="88" Canvas.Left="60" Width="20" Height="20" Fill="#14151C" />
                <Rectangle Canvas.Top="100" Canvas.Left="66" Width="8" Height="16" Fill="#14151C" />
            </Canvas>
        </Viewbox>

        <TextBlock x:Name="StatusText" Grid.Row="1" Text="Preparat"
                   Foreground="#B7BBC9" FontSize="16" HorizontalAlignment="Center"
                   Margin="0,10,0,0" />

        <Button x:Name="OpenButton" Grid.Row="2" Content="OBRIR PANY"
                Width="220" Height="56" Margin="0,25,0,0"
                FontSize="18" FontWeight="Bold" Foreground="White"
                Cursor="Hand" Click="OpenButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="28">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#4C6FFF" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#33364A" />
                            <Setter Property="Foreground" Value="#787C8E" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3E5DE0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <TextBlock x:Name="FooterText" Grid.Row="3" Foreground="#4A4E5E" FontSize="10"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
